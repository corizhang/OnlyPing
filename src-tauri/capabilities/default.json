{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-read-ai-key",
    "allow-write-ai-key",
    "allow-project-storage-ready",
    "allow-project-storage-migrate",
    "allow-project-storage-save",
    "allow-project-storage-read",
    "allow-project-storage-delete",
    "allow-project-storage-missing-assets",
    "allow-project-storage-list",
    "allow-project-storage-location",
    "allow-project-storage-open-directory",
    "allow-project-file-version",
    "allow-project-file-write",
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:allow-read-file",
    "fs:allow-write-file"
  ]
}
